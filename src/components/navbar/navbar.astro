---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import logoImage from "@/assets/logo.png"; 
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import ModelSign from "../modelsign.astro";

const menuitems = [
  {
    title: "Features",
    path: "#",
    children: [
      { title: "Donation", path: "/Donation" },
 
    ],
  },
  {
    title: "Pricing",
    path: "/pricing",
  },
  {
    title: "Calendar",
    path: "/Calendar",
  },
  
  {
    title: "Blog",
    path: "/blog",
  },
  {
    title: "Contact",
    path: "/contact",
  },

   
  
];
---


<Container>
  <ModelSign />

  <header class="flex flex-col lg:flex-row  relative z-20 justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="flex items-center space-x-2">
          <img
          src={logoImage.src}
          alt="Rysolf Logo"
          class="h-14 w-auto relative z-auto" 
        /> 
          <span class="text-lg font-bold text-slate-800">Osciluz</span>
          <span class="text-lg text-slate-500">Talk</span>
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-gray-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-gray-600 hover:text-gray-900">
                      <span> {item.title}</span>
                   
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
        <div class="lg:hidden flex items-center mt-3 gap-4">
          <Link href="#" id="loginLink" style="muted" block size="md">Log in</Link>
          <Link href="#" id="registerLink" size="md" block>Sign up</Link>
        </div>
      </MenuItems>
    </Astronav>
    <div>
      <div class="hidden lg:flex items-center gap-4">
        <a href="#" id="loginLinkDesktop">Log in</a>
        <Link href="#" id="registerLinkDesktop" size="md">Sign up</Link>
      </div>
    </div>
  </header>
</Container>
