---
export const prerender = false;
import WebRTC from "../../components/WebRTC.astro";
const wsUrl = import.meta.env.PUBLIC_WS_URL || '';
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/logo.png" type="image/png" />
    <title>Osciluz Talk - Videollamada</title>
    <script is:inline define:vars={{ wsUrl }}>
      if (wsUrl) window.__OSCILUZ_WS_URL = wsUrl;
    </script>
  </head>
  <body>
    <WebRTC />
  </body>
</html>
